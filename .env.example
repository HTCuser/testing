# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên git.

# --- Phân hệ 2: Sinh câu trả lời (tuỳ chọn) ---
# Không có key thì hệ thống vẫn tra cứu được, nhưng chỉ trả về trích đoạn tài liệu
# thay vì câu trả lời do mô hình tổng hợp.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Hạn mức gọi mô hình. Hết hạn mức thì tra cứu vẫn chạy, chỉ lùi về trích lược.
DAILY_ASK_LIMIT=100
MONTHLY_ASK_LIMIT=3000
# Mốc đổi ngày/tháng tính theo giờ nhà máy (Việt Nam = 7).
TIMEZONE_OFFSET_HOURS=7

# --- Phân hệ 1: Truy hồi ngữ nghĩa ---
# Mặc định bge-m3 chạy nội bộ qua Ollama: cài Ollama rồi chạy
#     ollama pull bge-m3
# Tài liệu không ra khỏi mạng nhà máy. Ollama không chạy thì truy hồi tự lùi về
# BM25 — trang Cấu hình sẽ báo đỏ khi không kết nối được.
# Hỗ trợ: openai_compatible (Ollama, LM Studio, vLLM), voyage, none
EMBEDDING_PROVIDER=openai_compatible
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=bge-m3

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Máy chủ ---
HOST=0.0.0.0
# Nên giữ 8000: dung-may-chu.bat, run.bat mặc định dùng cổng này.
PORT=8000

# Đăng nhập: không dùng quá chừng này giờ thì phải đăng nhập lại.
SESSION_IDLE_HOURS=12

# --- Sao lưu ---
# Đặt ra Ổ KHÁC ổ cài phần mềm (hoặc ổ cứng gắn ngoài) để hỏng ổ không mất cả
# dữ liệu lẫn bản sao. Để trống thì sao lưu vào thư mục sao-luu cạnh phần mềm.
SAO_LUU_DIR=
# Giữ bản chụp CSDL trong bao nhiêu ngày (luôn giữ ít nhất 7 bản gần nhất).
SAO_LUU_GIU_NGAY=30

# --- Nghiệp vụ ---
PLANT_NAME=Nhà máy Thủy điện Hủa Na

# Tên in ở đầu phiếu thao tác. Mặc định theo cách ghi chuẩn của nhà máy;
# đổi ở đây nếu tên đơn vị thay đổi.
ORG_NAME=CTCP Thủy điện Hủa Na
ORG_UNIT=Phân xưởng VH-SC Hủa Na
