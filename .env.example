# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên git.

# --- Sinh câu trả lời (tuỳ chọn) ---
# Không có key thì hệ thống vẫn tra cứu được, nhưng chỉ trả về trích đoạn tài liệu
# thay vì câu trả lời do mô hình tổng hợp.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Embedding ngữ nghĩa (tuỳ chọn) ---
# Để trống thì hệ thống chỉ dùng tìm kiếm từ khoá BM25 (chạy hoàn toàn offline).
# Hỗ trợ: voyage (khuyến nghị cho tiếng Việt), openai_compatible, none
EMBEDDING_PROVIDER=none
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Dùng cho EMBEDDING_PROVIDER=openai_compatible (OpenAI, Ollama, LM Studio, vLLM...)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=nomic-embed-text

# --- Máy chủ ---
HOST=0.0.0.0
PORT=8000

# --- Nghiệp vụ ---
PLANT_NAME=Nhà máy Thủy điện Hủa Na
